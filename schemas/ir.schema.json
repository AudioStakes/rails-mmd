{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audiostakes.example/schemas/rails-mmd/ir.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "domain_id", "entities", "relationships", "diagnostic_ids", "digest_sha256"],
  "properties": {
    "schema_version": { "const": 5 },
    "domain_id": { "$ref": "#/$defs/domain_id" },
    "entities": {
      "type": "array",
      "items": { "$ref": "#/$defs/entity" }
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "#/$defs/relationship" }
    },
    "diagnostic_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "digest_sha256": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "domain_id": {
      "type": "string",
      "allOf": [
        { "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$" },
        { "not": { "pattern": "\\s" } }
      ]
    },
    "ruby_constant": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9_]*(?:::[A-Z][A-Za-z0-9_]*)*$"
    },
    "entity": {
      "oneOf": [
        { "$ref": "#/$defs/physical_entity" },
        { "$ref": "#/$defs/sti_subtype_entity" }
      ]
    },
    "physical_entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "ruby_constant", "table_name", "attributes"],
      "properties": {
        "entity_id": { "type": "string", "minLength": 1 },
        "ruby_constant": { "$ref": "#/$defs/ruby_constant" },
        "table_name": { "type": "string", "minLength": 1 },
        "attributes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/attribute" }
        },
        "metadata": { "$ref": "#/$defs/sti_base_metadata" }
      }
    },
    "sti_subtype_entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "ruby_constant", "table_name", "attributes", "metadata"],
      "properties": {
        "entity_id": { "type": "string", "minLength": 1 },
        "ruby_constant": { "$ref": "#/$defs/ruby_constant" },
        "table_name": { "type": "string", "minLength": 1 },
        "attributes": {
          "type": "array",
          "maxItems": 0,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/attribute" }
        },
        "metadata": { "$ref": "#/$defs/sti_subtype_metadata" }
      }
    },
    "attribute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attribute_id", "name", "role", "type"],
      "properties": {
        "attribute_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "role": { "enum": ["primary_key", "foreign_key", "primary_foreign_key"] },
        "type": { "type": "string", "minLength": 1 }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationship_id",
        "owner_entity_id",
        "target_entity_id",
        "association_name",
        "owner_cardinality",
        "target_cardinality"
      ],
      "properties": {
        "relationship_id": { "type": "string", "minLength": 1 },
        "owner_entity_id": { "type": "string", "minLength": 1 },
        "target_entity_id": { "type": "string", "minLength": 1 },
        "association_name": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*[!?=]?$" },
        "owner_cardinality": { "$ref": "#/$defs/cardinality" },
        "target_cardinality": { "$ref": "#/$defs/cardinality" },
        "metadata": { "$ref": "#/$defs/relationship_metadata" }
      }
    },
    "relationship_metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scoped": { "const": true },
        "behavior": { "$ref": "#/$defs/relationship_behavior" }
      },
      "anyOf": [
        { "required": ["scoped"] },
        { "required": ["behavior"] }
      ]
    },
    "relationship_behavior": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from_owner": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/behavior_declaration" }
        },
        "from_target": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/behavior_declaration" }
        }
      },
      "anyOf": [
        { "required": ["from_owner"] },
        { "required": ["from_target"] }
      ]
    },
    "behavior_declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["association_name", "association_macro"],
      "properties": {
        "association_name": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$" },
        "association_macro": { "enum": ["belongs_to", "has_one", "has_many"] },
        "dependent": { "$ref": "#/$defs/dependent_behavior" },
        "touch": { "$ref": "#/$defs/touch_behavior" },
        "counter_cache": { "$ref": "#/$defs/counter_cache_behavior" }
      },
      "anyOf": [
        { "required": ["dependent"] },
        { "required": ["touch"] },
        { "required": ["counter_cache"] }
      ],
      "allOf": [
        {
          "if": {
            "properties": { "association_macro": { "const": "belongs_to" } },
            "required": ["association_macro"]
          },
          "then": {
            "properties": {
              "dependent": {
                "type": "object",
                "properties": {
                  "action": { "enum": ["destroy", "delete", "destroy_async"] },
                  "target": { "const": "associated_records" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "association_macro": { "const": "has_one" } },
            "required": ["association_macro"]
          },
          "then": {
            "not": { "required": ["counter_cache"] },
            "properties": {
              "dependent": {
                "type": "object",
                "properties": {
                  "action": {
                    "enum": [
                      "destroy",
                      "destroy_async",
                      "delete",
                      "nullify",
                      "restrict_with_error",
                      "restrict_with_exception"
                    ]
                  },
                  "target": { "const": "associated_records" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "association_macro": { "const": "has_many" } },
            "required": ["association_macro"]
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["touch"] },
                { "required": ["counter_cache"] }
              ]
            },
            "properties": {
              "dependent": {
                "type": "object",
                "properties": {
                  "action": {
                    "enum": [
                      "destroy",
                      "destroy_async",
                      "delete_all",
                      "nullify",
                      "restrict_with_error",
                      "restrict_with_exception"
                    ]
                  },
                  "target": { "enum": ["associated_records", "through_records"] }
                }
              }
            }
          }
        }
      ]
    },
    "dependent_behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "target"],
      "properties": {
        "action": {
          "enum": [
            "destroy",
            "delete",
            "destroy_async",
            "delete_all",
            "nullify",
            "restrict_with_error",
            "restrict_with_exception"
          ]
        },
        "target": { "enum": ["associated_records", "through_records"] }
      }
    },
    "touch_behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attribute"],
      "properties": {
        "attribute": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$" }
          ]
        }
      }
    },
    "counter_cache_behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["column", "active"],
      "properties": {
        "column": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$" },
        "active": { "type": "boolean" }
      }
    },
    "sti_base_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "inheritance_column"],
      "properties": {
        "kind": { "const": "sti_base" },
        "inheritance_column": { "type": "string", "minLength": 1 }
      }
    },
    "sti_subtype_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "base_entity_id", "parent_entity_id", "inheritance_column", "sti_name"],
      "properties": {
        "kind": { "const": "sti_subtype" },
        "base_entity_id": { "type": "string", "minLength": 1 },
        "parent_entity_id": { "type": "string", "minLength": 1 },
        "inheritance_column": { "type": "string", "minLength": 1 },
        "sti_name": { "type": "string", "minLength": 1 }
      }
    },
    "cardinality": { "enum": ["0..1", "1..1", "0..many", "1..many"] }
  }
}
